<?xml version="1.0" encoding="utf-8"?>
<!--
    ÍCONE ADAPTATIVO (Android 8.0 / API 26 ou superior).
    Junta a camada de fundo e a da frente; o launcher do celular aplica o formato
    (círculo, gota, quadrado...) e pode animar as camadas separadamente.
    "monochrome" = versão de uma cor só usada nos "ícones temáticos" do Android 13+.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
